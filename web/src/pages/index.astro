---
import BaseLayout from '../layouts/BaseLayout.astro';
import Placeholder from '../components/Placeholder.astro';
import { SITE, AREAS, ABOUT } from '../config/site';
const mosaic = [
  { span: 'a', ratio: '3 / 2', tone: 1 }, { span: 'b', ratio: '4 / 5', tone: 3 },
  { span: 'c', ratio: '4 / 5', tone: 0 }, { span: 'c', ratio: '1 / 1', tone: 4 }, { span: 'c', ratio: '4 / 5', tone: 2 },
  { span: 'b', ratio: '1 / 1', tone: 5 }, { span: 'a', ratio: '16 / 10', tone: 1 },
];
const strip = ['3 / 2', '4 / 5', '3 / 2', '1 / 1', '4 / 5', '16 / 9', '3 / 2', '4 / 5'];
const projects = [
  { title: 'Projeto de exemplo A', meta: 'Local e ano de exemplo', ratio: '3 / 2', tone: 2 },
  { title: 'Projeto de exemplo B', meta: 'Local e ano de exemplo', ratio: '3 / 2', tone: 4 },
  { title: 'Projeto de exemplo C', meta: 'Local e ano de exemplo', ratio: '3 / 2', tone: 1 },
];
---
<BaseLayout>
  <section class="hero">
    <Placeholder fill tone={0} label="Fotografia de destaque de exemplo" />
    <div class="wrap hero-text">
      <h1>{SITE.name}</h1>
      <p>{SITE.tagline || 'Frase de posicionamento de exemplo, editável no painel.'}</p>
    </div>
  </section>

  <section class="wrap section" aria-labelledby="areas">
    <h2 id="areas">Áreas de atuação</h2>
    <ul class="areas">{AREAS.map((a) => <li>{a}</li>)}</ul>
  </section>

  <section class="wrap section" aria-labelledby="selecao">
    <h2 id="selecao">Seleção</h2>
    <div class="mosaic">
      {mosaic.map((m) => <div class={`m-${m.span}`}><Placeholder ratio={m.ratio} tone={m.tone} /></div>)}
    </div>
  </section>

  <section class="section strip-section" aria-labelledby="sequencia">
    <div class="wrap strip-header">
      <h2 id="sequencia">Sequência</h2>
      <div class="strip-header-controls">
        <button type="button" class="strip-arrow strip-arrow-header" id="strip-btn-prev" aria-label="Fotografia anterior">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.75">
            <path d="M15 19l-7-7 7-7" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </button>
        <button type="button" class="strip-arrow strip-arrow-header" id="strip-btn-next" aria-label="Próxima fotografia">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.75">
            <path d="M9 5l7 7-7 7" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </button>
      </div>
    </div>

    <div class="strip-container">
      <button type="button" class="strip-arrow strip-arrow-lateral prev" id="strip-lat-prev" aria-label="Rolar para a esquerda">
        <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.75">
          <path d="M15 19l-7-7 7-7" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </button>

      <ul class="strip" id="photo-strip" tabindex="0" aria-label="Sequência de fotografias de exemplo">
        {strip.map((r, i) => <li style={`--r:${r}`}><Placeholder ratio={r} tone={i} /></li>)}
      </ul>

      <button type="button" class="strip-arrow strip-arrow-lateral next" id="strip-lat-next" aria-label="Rolar para a direita">
        <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.75">
          <path d="M9 5l7 7-7 7" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </button>
    </div>
  </section>

  <script>
    function setupStrip() {
      const strip = document.getElementById('photo-strip');
      if (!strip) return;

      const getScrollAmount = () => Math.max(340, strip.clientWidth * 0.7);

      const scrollLeft = () => strip.scrollBy({ left: -getScrollAmount(), behavior: 'smooth' });
      const scrollRight = () => strip.scrollBy({ left: getScrollAmount(), behavior: 'smooth' });

      document.getElementById('strip-lat-prev')?.addEventListener('click', scrollLeft);
      document.getElementById('strip-lat-next')?.addEventListener('click', scrollRight);
      document.getElementById('strip-btn-prev')?.addEventListener('click', scrollLeft);
      document.getElementById('strip-btn-next')?.addEventListener('click', scrollRight);
    }

    setupStrip();
    document.addEventListener('astro:page-load', setupStrip);
  </script>

  <section class="wrap section" aria-labelledby="projetos">
    <h2 id="projetos">Projetos em destaque</h2>
    {projects.map((p, i) => (
      <a class={`feature ${i % 2 ? 'flip' : ''}`} href="/projetos">
        <Placeholder ratio={p.ratio} tone={p.tone} caption="Ver projeto" label={`Capa de exemplo: ${p.title}`} />
        <div>
          <h3>{p.title}</h3>
          <p class="meta">{p.meta}</p>
          <p class="muted">Resumo de exemplo do ensaio, que será substituído pelo texto real.</p>
          <span class="link-u">Ver projeto</span>
        </div>
      </a>
    ))}
  </section>

  <section class="wrap section" aria-labelledby="fine">
    <h2 id="fine">Fotografias Fine Art</h2>
    <p class="muted">Obras autorais selecionadas, disponíveis para aquisição sob consulta.</p>
    <div class="fine-grid">
      {[1, 2, 3, 4].map((n) => <a class="plain" href="/fotografias"><Placeholder ratio="4 / 5" tone={n} caption="Consultar valores" /></a>)}
    </div>
    <p><a class="link-u" href="/fotografias">Ver todas as fotografias</a></p>
  </section>

  <section class="wrap section about" aria-labelledby="sobre">
    <Placeholder ratio="4 / 5" tone={2} label="Retrato de exemplo" />
    <div>
      <h2 id="sobre">Sobre o fotógrafo</h2>
      <p class="muted">{ABOUT.intro || 'Texto de apresentação de exemplo. A biografia real será escrita por Victor Hugo Camará no painel.'}</p>
      <p><a class="link-u" href="/sobre">Conhecer o trabalho</a></p>
    </div>
  </section>

  <section class="wrap section fine-art-feature" aria-labelledby="padrao-fine">
    <div class="fine-card">
      <span class="sub-label">Guia Técnico & Conservação</span>
      <h2 id="padrao-fine">O Padrão Fine Art de Impressão</h2>
      <p class="muted">
        Conheça os suportes 100% fibra de algodão Hahnemühle e Canson, as molduras em madeiras maciças nobres, os vidros com 99% de bloqueio UV e a certificação com selo holográfico numerado.
      </p>
      <div class="features-summary">
        <span class="feat-tag">Papéis 100% Algodão</span>
        <span class="feat-tag">Madeiras Nobres</span>
        <span class="feat-tag">Vidro Museu UV 99%</span>
        <span class="feat-tag">Certificado Holográfico</span>
      </div>
      <a class="button" href="/fine-art">Conhecer especificações Fine Art</a>
    </div>
  </section>

  <section class="dark cta" aria-labelledby="contato">
    <div class="wrap">
      <h2 id="contato">Exposições, parcerias e aquisição de obras</h2>
      <a class="button" href="/contato">Entrar em contato</a>
    </div>
  </section>
</BaseLayout>
<style>
  .hero { position: relative; min-height: min(86svh, 54rem); display: grid; align-items: end; color: #fff; }
  .hero-text { position: relative; padding-block: var(--space-5) var(--space-4); animation: rise 1.2s 0.15s cubic-bezier(0.2, 0.7, 0.2, 1) both; }
  .hero h1 { font-size: var(--text-display); line-height: 1; margin-bottom: var(--space-1); }
  .hero p { font-family: var(--font-serif); font-size: var(--text-lg); margin: 0; }
  @keyframes rise { from { opacity: 0; transform: translateY(18px); } }
  .areas { list-style: none; padding: 0; margin: 0; display: grid; gap: 0; grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr)); }
  .areas li { padding: var(--space-2) var(--space-2) var(--space-2) 0; border-top: 1px solid var(--color-line); font-family: var(--font-serif); font-size: var(--text-lg); }
  .mosaic { display: grid; gap: var(--space-2); grid-template-columns: repeat(12, 1fr); align-items: start; }
  .m-a { grid-column: span 7; } .m-b { grid-column: span 5; } .m-c { grid-column: span 4; }
  @media (max-width: 40rem) { .m-a, .m-b, .m-c { grid-column: span 12; } }
  .mosaic > div {
    position: relative;
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.4s cubic-bezier(0.16, 1, 0.3, 1);
    will-change: transform;
    border-radius: 2px;
  }
  .mosaic > div:hover {
    transform: translateY(-7px);
    box-shadow: 0 20px 42px -10px rgba(0, 0, 0, 0.38), 0 2px 8px rgba(0, 0, 0, 0.12);
    z-index: 10;
  }

  .strip-section { position: relative; padding-block: var(--space-4); }
  .strip-header { display: flex; align-items: center; justify-content: space-between; margin-bottom: var(--space-1); }
  .strip-header h2 { margin: 0; }
  .strip-header-controls { display: flex; gap: 0.5rem; }
  .strip-container { position: relative; width: 100%; }

  .strip {
    display: flex;
    gap: var(--space-2);
    list-style: none;
    margin: 0;
    padding: var(--space-3) var(--gutter);
    overflow-x: auto;
    scroll-behavior: smooth;
    scroll-snap-type: x proximity;
    scrollbar-width: none;
    -ms-overflow-style: none;
  }
  .strip::-webkit-scrollbar { display: none; }

  .strip li {
    flex: none;
    height: clamp(14rem, 34vw, 26rem);
    aspect-ratio: var(--r);
    scroll-snap-align: start;
    position: relative;
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.4s cubic-bezier(0.16, 1, 0.3, 1);
    will-change: transform;
    border-radius: 2px;
  }
  .strip li:hover {
    transform: translateY(-8px);
    box-shadow: 0 22px 46px -10px rgba(0, 0, 0, 0.42), 0 2px 10px rgba(0, 0, 0, 0.14);
    z-index: 10;
  }
  .strip li :global(.photo) { height: 100%; border-radius: 2px; }

  .strip-arrow {
    background: rgba(247, 246, 243, 0.94);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    border: 1px solid var(--color-line);
    color: var(--color-text);
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 9999px;
    transition: background-color 0.25s ease, color 0.25s ease, transform 0.25s ease, box-shadow 0.25s ease;
  }
  .strip-arrow:hover {
    background-color: var(--color-text);
    color: var(--color-bg);
    transform: scale(1.08);
    box-shadow: 0 6px 18px rgba(0, 0, 0, 0.16);
  }
  .strip-arrow-header {
    width: 2.25rem;
    height: 2.25rem;
  }
  .strip-arrow-lateral {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    z-index: 20;
    width: 3.25rem;
    height: 3.25rem;
    box-shadow: 0 4px 18px rgba(0, 0, 0, 0.14);
  }
  .strip-arrow-lateral.prev {
    left: clamp(0.75rem, 2.5vw, 2rem);
  }
  .strip-arrow-lateral.next {
    right: clamp(0.75rem, 2.5vw, 2rem);
  }
  .strip-arrow-lateral:hover {
    transform: translateY(-50%) scale(1.08);
  }
  @media (max-width: 48rem) {
    .strip-arrow-lateral { display: none; }
  }
  .feature { display: grid; gap: var(--space-3); grid-template-columns: 1.4fr 1fr; align-items: center; text-decoration: none; margin-top: var(--space-4); }
  .feature.flip { grid-template-columns: 1fr 1.4fr; }
  .feature.flip > :global(.photo) { order: 2; }
  .feature h3 { font-size: var(--text-xl); }
  .meta { font-size: var(--text-sm); color: var(--color-muted); }
  @media (max-width: 48rem) { .feature, .feature.flip { grid-template-columns: 1fr; } .feature.flip > :global(.photo) { order: 0; } }
  .plain { text-decoration: none; }
  .fine-grid { display: grid; gap: var(--space-2); grid-template-columns: repeat(auto-fit, minmax(min(100%, 11rem), 1fr)); margin-bottom: var(--space-3); }
  .about { display: grid; gap: var(--space-4); grid-template-columns: minmax(12rem, 22rem) 1fr; align-items: center; }
  @media (max-width: 40rem) { .about { grid-template-columns: 1fr; } }
  .cta { padding-block: var(--space-4); margin-top: var(--space-4); }
  .cta h2 { font-size: var(--text-xl); max-width: 22ch; }
  .fine-card { background: #ffffff; border: 1px solid var(--color-line); padding: clamp(1.75rem, 3.5vw, 3rem); box-shadow: 0 4px 20px rgba(0, 0, 0, 0.03); }
  .sub-label { display: inline-block; font-size: 0.6875rem; letter-spacing: 0.16em; text-transform: uppercase; font-weight: 600; color: #8c734b; margin-bottom: 0.5rem; }
  .features-summary { display: flex; flex-wrap: wrap; gap: 0.5rem; margin: 1.25rem 0 1.5rem; }
  .feat-tag { font-size: 0.75rem; letter-spacing: 0.08em; text-transform: uppercase; font-weight: 500; background: var(--color-bg); border: 1px solid var(--color-line); padding: 0.35rem 0.75rem; color: var(--color-text); }
</style>
