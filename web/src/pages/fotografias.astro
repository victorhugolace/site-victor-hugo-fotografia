---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageIntro from '../components/PageIntro.astro';
import Placeholder from '../components/Placeholder.astro';
const ratios = ['4 / 5', '3 / 2', '4 / 5', '1 / 1', '3 / 2', '4 / 5'];
---
<BaseLayout title="Fotografias Fine Art" description="Impressões Fine Art de Victor Hugo Camará, disponíveis sob consulta.">
  <PageIntro title="Fotografias" lead="Obras autorais selecionadas para aquisição. A disponibilidade de cada obra é definida individualmente. Os itens abaixo são exemplos." />
  <div class="wrap">
    <div class="columns">
      {ratios.map((r, i) => (
        <a href="/contato">
          <Placeholder ratio={r} tone={i} label={`Obra de exemplo ${i + 1}`} caption="Consultar valores" />
          <h2>Obra de exemplo {i + 1}</h2>
          <p class="muted">Local e ano de exemplo</p>
        </a>
      ))}
    </div>
    <p class="muted note">A aquisição de uma impressão física não transfere os direitos autorais da fotografia.</p>
  </div>
</BaseLayout>
<style>
  .columns { columns: 3 17rem; column-gap: var(--space-3); }
  .columns a { display: block; break-inside: avoid; margin-bottom: var(--space-4); text-decoration: none; }
  h2 { font-size: var(--text-base); margin: var(--space-2) 0 0.15rem; }
  p { font-size: var(--text-sm); }
  .note { margin-top: var(--space-2); }
</style>
