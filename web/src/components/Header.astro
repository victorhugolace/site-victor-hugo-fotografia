---
import { SITE, NAV } from '../config/site';
const current = Astro.url.pathname;
---
<header>
  <div class="wrap bar">
    <a class="brand" href="/">{SITE.name}</a>
    <nav aria-label="Principal">
      <ul>
        {NAV.map((item) => (
          <li><a href={item.href} aria-current={current.startsWith(item.href) ? 'page' : undefined}>{item.label}</a></li>
        ))}
      </ul>
    </nav>
  </div>
</header>
<style>
  .bar { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: var(--space-1) var(--space-4); padding-block: var(--space-3); }
  .brand { font-family: var(--font-serif); font-size: var(--text-lg); text-decoration: none; }
  ul { display: flex; flex-wrap: wrap; gap: var(--space-1) var(--space-3); list-style: none; margin: 0; padding: 0; font-size: var(--text-sm); }
  nav a { text-decoration: none; padding-block: 0.25rem; }
  nav a:hover, nav a[aria-current='page'] { text-decoration: underline; }
</style>
